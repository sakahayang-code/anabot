# ==============================================================================
# AnaBot Environment Configuration Template
# ==============================================================================
# Copy this file to your secret directory (or project root for local dev) as .env
# In Production: Place .env inside anabot_secrets/ outside the web/deployment directory.

# Application Environment
APP_NAME="AnaBot"
APP_ENV=development # development | testing | production
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

# Security & Encryption (AES-256-GCM)
# Generate with: php -r 'echo bin2hex(random_bytes(32));'
APP_KEY=
# Path to separate encryption key file if configured outside webroot
ENCRYPTION_KEY_PATH=

# Database Configuration (SQLite 3 via PDO)
# In production, this MUST point outside the deployment directory (e.g., /home/user/anabot_data/anabot.sqlite)
DB_CONNECTION=sqlite
DB_DATABASE=storage/database/anabot.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_FOREIGN_KEYS=true

# Storage & Production Separation Paths (Optional overrides for shared hosting)
# ANABOT_DATA_PATH=/home/username/anabot_data
# ANABOT_SECRETS_PATH=/home/username/anabot_secrets
STORAGE_PATH=storage
BACKUP_PATH=storage/backups
LOG_PATH=storage/logs
REPORT_PATH=storage/reports

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false # Set to true when running over HTTPS
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Login Rate Limiting (Throttle)
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15

# Cron Security Token
CRON_SECRET_TOKEN=

# AI Provider Settings (Default placeholders - Credentials stored encrypted in DB)
DEFAULT_AI_PROVIDER=gemini
AI_REQUEST_TIMEOUT=60
