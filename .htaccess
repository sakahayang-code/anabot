# AnaBot Shared Hosting Root Security & Forwarding
# Works seamlessly in root domain, addon domain, and subdirectories (e.g. /anabot/)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to private directories and sensitive files
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|bin|tests|\.env|\.git|composer\.(json|lock)|.*\.sqlite.*|.*\.key|.*\.log) - [F,L,NC]

    # Stop processing if request already points to public/
    RewriteRule ^public/ - [L]

    # Forward all other requests to public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
